{
  "expo": {
    "name": "Contas em Dia",
    "slug": "contas-em-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.felipebellis.contas"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.felipebellis.contas",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0E7C66"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O app cria eventos na sua agenda para lembrar dos vencimentos das contas."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use o Face ID para desbloquear o Contas em Dia."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use o Face ID para desbloquear o Contas em Dia."
        }
      ]
    ],
    "scheme": "contasemdia",
    "experiments": {
      "typedRoutes": true
    }
  }
}
